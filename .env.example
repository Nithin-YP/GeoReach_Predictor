# Django Settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
DATABASE_URL="postgis://georeach:pass@localhost:5432/georeach_db"

# GIS Library Path, check your installation path
GDAL_LIBRARY_PATH="C:/Users/<UserName>/miniconda3/envs/georeach_env/Library/bin/gdal.dll"
GEOS_LIBRARY_PATH="C:/Users/<UserName>/miniconda3/envs/georeach_env/Library/bin/geos_c.dll"

# Admin Credentials
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-password

# Security Settings
SECURE_SSL_REDIRECT=False
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True

# PostgreSQL Settings
PG_HOST=localhost
PG_PORT=5432
PG_USER=<your-username>
PG_PASSWORD=<your-password>
PG_DBNAME=georeach_db